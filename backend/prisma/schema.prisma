datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
    output   = "../generated"
}

model User {
    user_id           String                 @id @default(uuid())
    email             String                 @unique
    email_verified    Boolean                @default(false)
    password_hash     String?
    name              String
    updated_at        DateTime               @updatedAt
    createdHouseholds Household[]
    memberships       HouseholdMember[]
    invitations       HouseholdInvitation[]
    requests          HouseholdJoinRequest[]
    items             Item[]
    itemHistories     ItemHistory[]
    reminders         Reminder[]
    refreshTokens     RefreshToken[]
}

model RefreshToken {
    token_id    String    @id @default(uuid())
    user_id     String
    token_hash  String    @unique
    device_info String?
    created_at  DateTime  @default(now())
    expires_at  DateTime
    revoked_at  DateTime?

    user User @relation(fields: [user_id], references: [user_id])
}

model Household {
    household_id String   @id @default(uuid())
    name         String
    created_by   String
    updated_at   DateTime @updatedAt

    creator               User                   @relation(fields: [created_by], references: [user_id])
    members               HouseholdMember[]
    invitations           HouseholdInvitation[]
    householdJoinRequests HouseholdJoinRequest[]
    categories            Category[]
}

enum Role {
    OWNER
    MEMBER
}

model HouseholdMember {
    user_id      String @id
    household_id String
    role         Role

    household Household @relation(fields: [household_id], references: [household_id])
    user      User      @relation(fields: [user_id], references: [user_id])

    @@index([household_id])
}

//! For invitations, we can use email to see if user is already in our system, and send a push notification on top of an email
enum InvitationStatus {
    PENDING
    ACCEPTED
    DECLINED
    EXPIRED
}

model HouseholdInvitation {
    invitation_id String           @id @default(uuid())
    household_id  String
    code          String           @unique
    invited_by    String
    email         String
    created_at    DateTime         @default(now())
    expires_at    DateTime
    status        InvitationStatus @default(PENDING)

    household Household @relation(fields: [household_id], references: [household_id])
    inviter   User      @relation(fields: [invited_by], references: [user_id])

    @@unique([household_id, email])
}

enum JoinRequestStatus {
    PENDING
    ACCEPTED
    DECLINED
}

model HouseholdJoinRequest {
    household_id String
    requested_by String
    status       JoinRequestStatus @default(PENDING)
    created_at   DateTime          @default(now())

    household Household @relation(fields: [household_id], references: [household_id])
    requester User      @relation(fields: [requested_by], references: [user_id])

    @@id([household_id, requested_by])
}

model Category {
    category_id  String  @id @default(uuid())
    household_id String
    name         String
    description  String?
    icon         String?
    color        String?

    household Household @relation(fields: [household_id], references: [household_id])
    items     Item[]
}

enum ItemType {
    CONSUMABLE
    MAINTENANCE
    BILL
    APPOINTMENT
}

model Item {
    item_id       String   @id @default(uuid())
    name          String
    category_id   String
    icon          String?
    item_type     ItemType
    notes         String?
    purchase_link String?
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt
    created_by    String

    category  Category      @relation(fields: [category_id], references: [category_id])
    creator   User          @relation(fields: [created_by], references: [user_id])
    schedule  ItemSchedule?
    histories ItemHistory[]
    reminders Reminder[]
}

enum TrackingMode {
    INTERVAL
    FIXED_DATE
    RECURRING
}

model ItemSchedule {
    item_id           String
    tracking_mode     TrackingMode
    interval_days     Int?
    fixed_due_date    DateTime?
    recurrence_rule   String?
    lead_time_days    Int?
    last_completed_at DateTime?
    next_due_date     DateTime
    updated_at        DateTime     @updatedAt

    item Item @relation(fields: [item_id], references: [item_id])

    @@id([item_id])
}

model ItemHistory {
    history_id   String   @id @default(uuid())
    item_id      String
    completed_at DateTime @default(now())
    completed_by String
    notes        String?

    item      Item @relation(fields: [item_id], references: [item_id])
    completer User @relation(fields: [completed_by], references: [user_id])
}

model Reminder {
    reminder_id String   @id @default(uuid())
    item_id     String
    user_id     String
    remind_at   DateTime

    item Item @relation(fields: [item_id], references: [item_id])
    user User @relation(fields: [user_id], references: [user_id])

    @@unique([item_id, user_id, remind_at])
}
